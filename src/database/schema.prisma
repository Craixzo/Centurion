generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  robloxId       String
  groupId        String
  suspendedUntil DateTime?
  unsuspendRank  Int?
  isBanned       Boolean   @default(false)

  @@unique([robloxId, groupId])
  @@index([groupId])
}

model XpRecord {
  robloxId String @id
  xp       Int    @default(0)

  @@index([xp])
}

model Event {
  id        String   @id @default(uuid())
  guildId   String
  channelId String
  messageId String   @unique
  title     String
  details   String?
  type      String?
  gameLink  String?
  startsAt  DateTime?
  hostId    String
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())

  remind5Sent     Boolean @default(false)
  remindStartSent Boolean @default(false)

  rsvps EventRsvp[]

  @@index([guildId])
  @@index([hostId])
  @@index([startsAt])
}

model EventRsvp {
  id        String  @id @default(uuid())
  eventId   String
  discordId String
  attending Boolean @default(true)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, discordId])
}

model Loa {
  id        String    @id @default(uuid())
  guildId   String
  discordId String
  reason    String
  startsAt  DateTime  @default(now())
  endsAt    DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([guildId, discordId])
  @@index([endsAt])
}

model QuotaStrike {
  id            String   @id @default(uuid())
  guildId       String
  groupId       String
  discordId     String
  strikes       Int      @default(0)
  lastCheckedAt String?
  fired         Boolean  @default(false)

  @@unique([guildId, groupId, discordId])
  @@index([guildId, groupId])
}
/// One row per recruitment attempt. Kept forever as service history.
/// activeKey holds the Discord ID while the request is active and is cleared
/// once it is completed or closed, so the database itself refuses a second
/// active request for the same person.
model RecruitmentRequest {
  id               String    @id @default(uuid())
  guildId          String
  discordId        String
  username         String
  displayName      String?
  branch           String?
  status           String    @default("PENDING_BRANCH")
  activeKey        String?   @unique
  officerId        String?
  channelId        String?
  controlMessageId String?
  noticeChannelId  String?
  noticeMessageId  String?
  dmReachable      Boolean   @default(true)
  flag             String?
  recruitSpoke     Boolean   @default(false)
  officerSpoke     Boolean   @default(false)
  division         String?
  closeReason      String?
  claimedAt        DateTime?
  reminderSentAt   DateTime?
  extendedAt       DateTime?
  createdAt        DateTime  @default(now())
  lastActivityAt   DateTime  @default(now())
  completedAt      DateTime?
  closedAt         DateTime?

  logs RecruitmentLog[]

  @@index([status])
  @@index([discordId])
  @@index([officerId])
  @@index([channelId])
}

/// Audit trail for a recruitment request. actorId is null for system actions.
model RecruitmentLog {
  id        String   @id @default(uuid())
  requestId String
  actorId   String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  request RecruitmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

/// A news outlet (a newspaper or news site) registered on the Yellonia website.
/// status: PENDING (awaiting the Ministry of Commerce), APPROVED, DENIED, SUSPENDED
model NewsOutlet {
  id               String    @id @default(uuid())
  slug             String    @unique
  name             String
  tagline          String?
  description      String?
  accentColor      String    @default("#bed215")
  iconFile         String?
  coverFile        String?
  /// JSON array of section names, e.g. ["Politics","Military"]
  sections         String    @default("[]")
  ownerId          String
  status           String    @default("PENDING")
  requestChannelId String?
  requestMessageId String?
  reviewedBy       String?
  reviewNote       String?
  createdAt        DateTime  @default(now())
  approvedAt       DateTime?

  members  NewsMember[]
  articles NewsArticle[]

  @@index([status])
  @@index([ownerId])
}

/// Someone who can write for an outlet.
/// role: OWNER, WRITER. status: PENDING (awaiting the Ministry), ACTIVE, DENIED, REMOVED
model NewsMember {
  id          String    @id @default(uuid())
  outletId    String
  discordId   String
  displayName String
  role        String    @default("WRITER")
  status      String    @default("PENDING")
  addedBy     String?
  createdAt   DateTime  @default(now())
  approvedAt  DateTime?

  outlet NewsOutlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, discordId])
  @@index([discordId])
}

/// One article. body is a JSON array of blocks (paragraphs, headings, quotes, images).
/// status: DRAFT, SUBMITTED (awaiting staff review), PUBLISHED, REJECTED, REMOVED
model NewsArticle {
  id                String    @id @default(uuid())
  outletId          String
  slug              String
  headline          String
  summary           String?
  body              String    @default("[]")
  coverFile         String?
  coverCaption      String?
  section           String?
  authorId          String
  authorName        String
  status            String    @default("DRAFT")
  isCoverStory      Boolean   @default(false)
  reviewedBy        String?
  reviewNote        String?
  announceMessageId String?
  /// Random key for the review link, so reviewers can read an unpublished article
  previewKey        String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  submittedAt       DateTime?
  publishedAt       DateTime?

  outlet NewsOutlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, slug])
  @@index([status])
  @@index([outletId, status, publishedAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  robloxId       String
  groupId        String
  suspendedUntil DateTime?
  unsuspendRank  Int?
  isBanned       Boolean   @default(false)

  @@unique([robloxId, groupId])
  @@index([groupId])
}

model XpRecord {
  robloxId String @id
  xp       Int    @default(0)

  @@index([xp])
}

model Event {
  id        String   @id @default(uuid())
  guildId   String
  channelId String
  messageId String   @unique
  title     String
  details   String?
  type      String?
  gameLink  String?
  startsAt  DateTime?
  hostId    String
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())

  remind5Sent     Boolean @default(false)
  remindStartSent Boolean @default(false)

  rsvps EventRsvp[]

  @@index([guildId])
  @@index([hostId])
  @@index([startsAt])
}

model EventRsvp {
  id        String  @id @default(uuid())
  eventId   String
  discordId String
  attending Boolean @default(true)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, discordId])
}

model Loa {
  id        String    @id @default(uuid())
  guildId   String
  discordId String
  reason    String
  startsAt  DateTime  @default(now())
  endsAt    DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([guildId, discordId])
  @@index([endsAt])
}

model QuotaStrike {
  id            String   @id @default(uuid())
  guildId       String
  groupId       String
  discordId     String
  strikes       Int      @default(0)
  lastCheckedAt String?
  fired         Boolean  @default(false)

  @@unique([guildId, groupId, discordId])
  @@index([guildId, groupId])
}
/// One row per recruitment attempt. Kept forever as service history.
/// activeKey holds the Discord ID while the request is active and is cleared
/// once it is completed or closed, so the database itself refuses a second
/// active request for the same person.
model RecruitmentRequest {
  id               String    @id @default(uuid())
  guildId          String
  discordId        String
  username         String
  displayName      String?
  branch           String?
  status           String    @default("PENDING_BRANCH")
  activeKey        String?   @unique
  officerId        String?
  channelId        String?
  controlMessageId String?
  noticeChannelId  String?
  noticeMessageId  String?
  dmReachable      Boolean   @default(true)
  flag             String?
  recruitSpoke     Boolean   @default(false)
  officerSpoke     Boolean   @default(false)
  division         String?
  closeReason      String?
  claimedAt        DateTime?
  reminderSentAt   DateTime?
  extendedAt       DateTime?
  createdAt        DateTime  @default(now())
  lastActivityAt   DateTime  @default(now())
  completedAt      DateTime?
  closedAt         DateTime?

  logs RecruitmentLog[]

  @@index([status])
  @@index([discordId])
  @@index([officerId])
  @@index([channelId])
}

/// Audit trail for a recruitment request. actorId is null for system actions.
model RecruitmentLog {
  id        String   @id @default(uuid())
  requestId String
  actorId   String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  request RecruitmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

/// A news outlet (a newspaper or news site) registered on the Yellonia website.
/// status: PENDING (awaiting the Ministry of Commerce), APPROVED, DENIED, SUSPENDED
model NewsOutlet {
  id               String    @id @default(uuid())
  slug             String    @unique
  name             String
  tagline          String?
  description      String?
  accentColor      String    @default("#bed215")
  iconFile         String?
  coverFile        String?
  /// JSON array of section names, e.g. ["Politics","Military"]
  sections         String    @default("[]")
  ownerId          String
  status           String    @default("PENDING")
  requestChannelId String?
  requestMessageId String?
  reviewedBy       String?
  reviewNote       String?
  createdAt        DateTime  @default(now())
  approvedAt       DateTime?

  members  NewsMember[]
  articles NewsArticle[]

  @@index([status])
  @@index([ownerId])
}

/// Someone who can write for an outlet.
/// role: OWNER, WRITER. status: PENDING (awaiting the Ministry), ACTIVE, DENIED, REMOVED
model NewsMember {
  id          String    @id @default(uuid())
  outletId    String
  discordId   String
  displayName String
  role        String    @default("WRITER")
  status      String    @default("PENDING")
  addedBy     String?
  createdAt   DateTime  @default(now())
  approvedAt  DateTime?

  outlet NewsOutlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, discordId])
  @@index([discordId])
}

/// One article. body is a JSON array of blocks (paragraphs, headings, quotes, images).
/// status: DRAFT, SUBMITTED (awaiting staff review), PUBLISHED, REJECTED, REMOVED
model NewsArticle {
  id                String    @id @default(uuid())
  outletId          String
  slug              String
  headline          String
  summary           String?
  body              String    @default("[]")
  coverFile         String?
  coverCaption      String?
  section           String?
  authorId          String
  authorName        String
  status            String    @default("DRAFT")
  isCoverStory      Boolean   @default(false)
  reviewedBy        String?
  reviewNote        String?
  announceMessageId String?
  /// Random key for the review link, so reviewers can read an unpublished article
  previewKey        String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  submittedAt       DateTime?
  publishedAt       DateTime?

  outlet NewsOutlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, slug])
  @@index([status])
  @@index([outletId, status, publishedAt])
}

/// A member of the Department of Emergency Services who can log in to the DES back-end.
/// department: POLICE, FIRE. status: ACTIVE, FORMER, SUSPENDED.
/// roles: JSON array, e.g. ["officer","supervisor"].
model DesMember {
  id             String    @id @default(uuid())
  discordId      String    @unique
  robloxUsername String
  badgeId        String    @unique
  department     String
  rank           String
  unit           String?
  roles          String    @default("[\"officer\"]")
  status         String    @default("ACTIVE")
  /// One-way scrypt hash; null until the member sets a password
  passwordHash   String?
  passwordSetAt  DateTime?
  /// Raised when the password changes or access is removed, which logs out every session
  tokenVersion   Int       @default(0)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  /// Why they left (shown in Former Personnel)
  leaveReason    String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([department, status])
}

/// Everything done in the DES back-end, for the audit log.
model DesAudit {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

/// A person in the DES Criminal Database: an IN-GAME character, keyed to a Roblox account.
/// Only in-game information is kept here, never real-world personal details.
model DesSubject {
  id             String    @id @default(uuid())
  robloxUserId   String    @unique
  robloxUsername String
  /// Their in-game character name, if different from the username
  characterName  String?
  /// JSON array of in-game flags, e.g. ["armed","flight-risk"]
  flags          String    @default("[]")
  notes          String?
  createdBy      String
  removed        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  records  DesRecord[]
  warrants DesWarrant[]

  @@index([robloxUsername])
}

/// One entry on a subject's record. kind: ARREST, CITATION, WARNING, NOTE
model DesRecord {
  id            String    @id @default(uuid())
  subjectId     String
  kind          String
  /// JSON array of in-game charges
  charges       String    @default("[]")
  summary       String
  location      String?
  officerId     String
  officerName   String
  removed       Boolean   @default(false)
  removedBy     String?
  removedReason String?
  createdAt     DateTime  @default(now())

  subject DesSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([createdAt])
}

/// A warrant. status: ACTIVE, SERVED, RECALLED. danger: LOW, MEDIUM, HIGH.
/// onWantedList puts an ACTIVE warrant on the public Most Wanted page.
model DesWarrant {
  id           String    @id @default(uuid())
  number       String    @unique
  subjectId    String
  charges      String    @default("[]")
  summary      String
  danger       String    @default("MEDIUM")
  status       String    @default("ACTIVE")
  onWantedList Boolean   @default(false)
  issuedBy     String
  issuedByName String
  issuedAt     DateTime  @default(now())
  closedBy     String?
  closedAt     DateTime?
  closedNote   String?

  subject DesSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([status, onWantedList])
  @@index([subjectId])
}

/// A CAD incident (a call for service). priority 1 (most urgent) to 4.
/// status: PENDING (no units yet), ACTIVE (units assigned), CLOSED.
model DesIncident {
  id          String    @id @default(uuid())
  number      String    @unique
  priority    Int       @default(3)
  type        String
  location    String
  description String?
  caller      String?
  status      String    @default("PENDING")
  disposition String?
  subjects    String    @default("[]")
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?

  log   DesIncidentLog[]
  units DesUnit[]

  @@index([status])
}

/// One line in an incident's narrative. kind: NOTE, STATUS, ASSIGN, SYSTEM
model DesIncidentLog {
  id         String   @id @default(uuid())
  incidentId String
  kind       String   @default("NOTE")
  text       String
  actorName  String
  createdAt  DateTime @default(now())

  incident DesIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([createdAt])
}

/// A unit on duty: one member under a callsign.
/// status: AVAILABLE, ENROUTE, ONSCENE, BUSY, OOS (out of service)
model DesUnit {
  id         String    @id @default(uuid())
  callsign   String    @unique
  memberId   String    @unique
  memberName String
  department String
  status     String    @default("AVAILABLE")
  incidentId String?
  since      DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  incident DesIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
}

/// An OIA complaint or an OFI fire investigation.
/// kind: OFFICER (complaint about an officer), DEPARTMENT (about a department), FIRE (OFI)
/// status: NEW (received / reported), OPEN (being investigated), CLOSED, DISMISSED
model DesCase {
  id                 String    @id @default(uuid())
  number             String    @unique
  kind               String
  status             String    @default("NEW")
  department         String?
  title              String
  description        String
  location           String?
  occurredAt         String?
  /// JSON array of evidence links
  evidence           String    @default("[]")
  /// What the person filing it typed about who's involved
  accusedText        String?
  /// The DES member the complaint is about, once matched
  accusedMemberId    String?
  accusedName        String?
  /// JSON array of linked Criminal Database subject ids
  subjects           String    @default("[]")
  linkedCall         String?
  submitterDiscordId String?
  submitterName      String
  internal           Boolean   @default(false)
  assignedTo         String?
  assignedName       String?
  /// OFFICER/DEPARTMENT: the finding. FIRE: the cause.
  finding            String?
  /// What the person who filed it is told when it's closed
  publicNote         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  closedAt           DateTime?

  log DesCaseLog[]

  @@index([kind, status])
  @@index([submitterDiscordId])
  @@index([accusedMemberId])
}

/// One line in a case's internal log. kind: NOTE, STATUS, SYSTEM
model DesCaseLog {
  id        String   @id @default(uuid())
  caseId    String
  kind      String   @default("NOTE")
  text      String
  actorName String
  createdAt DateTime @default(now())

  case DesCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

/// A notice on the DES back-end board. department null = everyone.
model DesPost {
  id         String   @id @default(uuid())
  title      String
  body       String
  department String?
  pinned     Boolean  @default(false)
  authorId   String
  authorName String
  removed    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([removed, pinned, createdAt])
}

/// An application to join DES from the public form.
/// status: PENDING, REVIEW (interview / being looked at), ACCEPTED, DECLINED, WITHDRAWN
model DesApplication {
  id             String    @id @default(uuid())
  number         String    @unique
  discordId      String
  discordName    String
  robloxUserId   String
  robloxUsername String
  department     String
  /// JSON array of { q, a }
  answers        String    @default("[]")
  status         String    @default("PENDING")
  publicNote     String?
  reviewedBy     String?
  reviewedName   String?
  memberId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  decidedAt      DateTime?

  log DesApplicationLog[]

  @@index([status])
  @@index([discordId])
}

/// One line in an application's internal log. kind: NOTE, STATUS, SYSTEM
model DesApplicationLog {
  id            String   @id @default(uuid())
  applicationId String
  kind          String   @default("NOTE")
  text          String
  actorName     String
  createdAt     DateTime @default(now())

  application DesApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

/// A corporation. `data` is the full company record as JSON, in the same shape the
/// game's CompanyService and CompanyDashboardService use (Ticker, Name, Holders, Members...).
/// The other columns are copies for searching. Every change bumps `version` (so two
/// writers can't overwrite each other) and `seq` (so game servers can fetch only what changed).
/// state: PENDING (registered on Discord or the website, fee not paid yet), RAISING, LISTED, SUSPENDED
model EconCompany {
  ticker       String   @id
  name         String
  typeId       String
  ownerId      String
  state        String
  data         String
  version      Int      @default(1)
  seq          Int      @default(0)
  source       String   @default("GAME")
  registeredBy String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([seq])
  @@index([ownerId])
  @@index([state])
}

/// A reserved ticker. Reserved before money moves, so two people can't claim one at once.
model EconTicker {
  ticker    String   @id
  ownerId   String
  name      String
  createdAt DateTime @default(now())
}

/// A Roblox user's brokerage account: Y$ deposited from the game, used to trade on the website and Discord.
model EconAccount {
  robloxId  String   @id
  cash      Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Money movements one person sees in their History.
/// kind: buy, sell, founded, deposit, withdraw, rejected. source: GAME, WEB, DISCORD
model EconLedger {
  id        Int      @id @default(autoincrement())
  robloxId  String
  kind      String
  ticker    String?
  name      String?
  shares    Int      @default(0)
  total     Int      @default(0)
  source    String   @default("GAME")
  note      String?
  createdAt DateTime @default(now())

  @@index([robloxId, id])
}

/// Share price samples, in three tiers (fine ~1 min, hour, day) like the game's old PriceHistory.
model EconPrice {
  id     Int    @id @default(autoincrement())
  ticker String
  tier   String
  t      Int
  c      Float

  @@index([ticker, tier, t])
}

/// The economy audit log (company created, listed, trades). Kept to the last few thousand.
model EconLog {
  id        Int      @id @default(autoincrement())
  kind      String
  ticker    String?
  data      String
  createdAt DateTime @default(now())
}

/// Counters, e.g. the change number game servers fetch from.
model EconCounter {
  id    String @id
  value Int    @default(0)
}

/// A modmail conversation between someone and Yellonia staff. status: OPEN, CLOSED.
/// lastFrom: USER or STAFF (who wrote last, so staff can see who's waiting).
model ModmailThread {
  id          String    @id @default(uuid())
  number      String    @unique
  discordId   String
  discordName String
  subject     String
  status      String    @default("OPEN")
  lastFrom    String    @default("USER")
  channelId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?

  messages ModmailMessage[]

  @@index([discordId])
  @@index([status])
}

/// One message in a modmail conversation. internal = staff-only note. source: DISCORD, WEB, SYSTEM
model ModmailMessage {
  id         String   @id @default(uuid())
  threadId   String
  fromStaff  Boolean  @default(false)
  internal   Boolean  @default(false)
  authorId   String
  authorName String
  body       String
  source     String   @default("WEB")
  createdAt  DateTime @default(now())

  thread ModmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

/// A job board listing. status: OPEN, CLOSED, REMOVED (by staff).
model JobListing {
  id           String    @id @default(uuid())
  title        String
  organisation String
  category     String
  description  String
  requirements String?
  applyOnSite  Boolean   @default(true)
  howToApply   String?
  status       String    @default("OPEN")
  postedBy     String
  postedName   String
  closesAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([postedBy])
}

/// An application to a job listing. status: PENDING, ACCEPTED, DECLINED, WITHDRAWN
model JobApplication {
  id             String    @id @default(uuid())
  listingId      String
  discordId      String
  discordName    String
  robloxUsername String
  robloxUserId   String
  message        String
  status         String    @default("PENDING")
  note           String?
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?

  @@index([listingId])
  @@index([discordId])
}

/// An official document (the Constitution, laws, decrees...). status: PUBLISHED, DRAFT
model SiteDocument {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  category      String
  summary       String?
  body          String
  effectiveDate String?
  status        String    @default("DRAFT")
  updatedBy     String
  updatedName   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publishedAt   DateTime?

  @@index([status])
}

/// What staff did in the staff area.
model SiteAudit {
  id        String   @id @default(uuid())
  actorId   String
  actorName String
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
